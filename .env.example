# OpenRouter LLM API Key (Primary LLM for Enrichment, Summaries, Q&A)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Hugging Face API Key (Embeddings & Inference)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HF_TOKEN=your_huggingface_api_key_here

# Google Gemini API Key (Fallback)
GOOGLE_API_KEY=your_gemini_api_key_here

# Database Configuration (SQLite for local, PostgreSQL for production)
DATABASE_URL=sqlite:///data/catalog.db

# Embedding Model (Hugging Face / SentenceTransformers)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHROMA_COLLECTION_NAME=rag_collection

# Processing & Concurrency
MAX_CONCURRENT_TASKS=10
REQUEST_TIMEOUT_SECONDS=30
CACHE_TTL_SECONDS=86400
